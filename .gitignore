# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Full-resolution source art. public/textures/mountains.jpg is the derived,
# shipped copy (2560px, 434 KB); this is the 6.6 MB original it came from and
# nothing in the build reads it. Kept out of git so it does not sit in history
# forever — back it up somewhere else if you want to re-derive the texture.
/assets-src/

# Splat intermediates nothing references. The three pruned *-opt.spz files ARE
# tracked (lib/themes.js points splatUrl at them, so re-enabling a theme's splat
# stays the documented one-line change); these two are dead:
#   *-shrunk.spz  the old fixed-stride reduction, superseded by -opt.spz
#                 (12.94 dB vs 29.55 dB at the same splat count -- Крок 21)
#   *.rad         Mint's own LOD/streaming container. Spark cannot parse it and
#                 no public decoder exists -- Крок 20.
/public/*-shrunk.spz
/public/*.rad

# Screenshots and shader dumps written by tools/shoot.mjs and tools/fogdiag.mjs.
# The tools are checked in (they encode how the fog and rock numbers were
# measured); their output is scratch.
/tools/shots/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
